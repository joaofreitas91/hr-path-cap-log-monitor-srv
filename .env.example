# Credenciais do SMTP usado pelas notificações por e-mail (srv/lib/mailer.js).
# Arquivo local e fora do git: em Cloud Foundry as mesmas variáveis são definidas
# com `cf set-env`. Sem SMTP_HOST nada é enviado, apenas registrado no log.
# Para testar localmente: npx maildev (SMTP 1025, caixa em http://localhost:1080)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Destination local usada pelo reprocessamento de logs (srv/lib/reprocess-trigger.js).
# Lida pelo @sap-cloud-sdk/connectivity quando não há serviço de destination (fora do BTP).
# O nome aqui é o que o administrador informa em "Destination" no cockpit.
destinations=[{"name":"REPROCESS_TEST","url":"http://localhost:3100"}]
