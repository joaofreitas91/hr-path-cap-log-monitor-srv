@server=http://localhost:4004
@username=john.doe@dummy.com
@password=1234


### IntegrationNotifications
# @name IntegrationNotifications_GET_OF_SF_TO_S4
GET {{server}}/odata/v4/log-monitor-cockpit/IntegrationNotifications?$filter=integration_ID eq a1b2c3d4-0001-4000-8000-000000000001&$expand=user,integrationGroup($expand=group)
Authorization: Basic {{username}}:{{password}}


### IntegrationNotifications
# @name IntegrationNotifications_POST_USER_JOHN_DOE
POST {{server}}/odata/v4/log-monitor-cockpit/IntegrationNotifications
Content-Type: application/json
Authorization: Basic {{username}}:{{password}}

{
  "ID": "c3d4e5f6-0001-4000-8000-000000000001",
  "integration_ID": "a1b2c3d4-0001-4000-8000-000000000001",
  "user_ID": "591361b7-b299-42ef-955e-ba7878eeb060",
  "notifyOnError": true
}


