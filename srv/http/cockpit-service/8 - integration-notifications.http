### IntegrationNotifications
# @name IntegrationNotifications_BATCH_SAME_USER_TWICE (expect 409 for the second)
POST {{server}}/odata/v4/log-monitor-cockpit/$batch
Content-Type: application/json
Authorization: Basic {{username}}:{{password}}

{
  "requests": [
    {
      "id": "r1",
      "atomicityGroup": "g1",
      "method": "POST",
      "url": "IntegrationNotifications",
      "headers": { "content-type": "application/json" },
      "body": {
        "integration_ID": "a1b2c3d4-0001-4000-8000-000000000001",
        "user_ID": "9291ac54-b142-423f-bd22-dd3c4a821be4",
        "notifyOnError": true
      }
    },
    {
      "id": "r2",
      "atomicityGroup": "g1",
      "method": "POST",
      "url": "IntegrationNotifications",
      "headers": { "content-type": "application/json" },
      "body": {
        "integration_ID": "a1b2c3d4-0001-4000-8000-000000000001",
        "user_ID": "9291ac54-b142-423f-bd22-dd3c4a821be4",
        "notifyOnError": true
      }
    }
  ]
}


