@server=http://localhost:4004
@username=integration
@password=1234


### IntegrationLogs
# @name IntegrationLogs_POST_SF
POST {{server}}/odata/v4/log-monitor-integration/IntegrationLogs
Content-Type: application/json
Authorization: Basic {{username}}:{{password}}

{
  "ID": "1265ac03-a1a3-4b0d-9dac-0ca70b478198",
