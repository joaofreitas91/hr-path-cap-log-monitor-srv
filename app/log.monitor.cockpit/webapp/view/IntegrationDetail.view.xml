<mvc:View
    controllerName="com.hrpath.log.monitor.cockpit.controller.IntegrationDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:uxap="sap.uxap"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
>
    <uxap:ObjectPageLayout
        id="integrationDetailPage"
        useIconTabBar="true"
        showTitleInHeaderContent="false"
        upperCaseAnchorBar="false"
        showAnchorBarPopover="false"
        class="lmcPage"
    >
        <uxap:headerTitle>
            <uxap:ObjectPageDynamicHeaderTitle id="integrationDetailTitle">
                <uxap:breadcrumbs>
                    <Breadcrumbs id="integrationBreadcrumbs" currentLocationText="{description}">
                        <Link id="lnkIntegrations" text="{i18n>navIntegrations}" press=".onNavBack" />
                    </Breadcrumbs>
                </uxap:breadcrumbs>
                <uxap:heading>
                    <Title id="integrationDetailHeading" text="{description}" level="H1" class="lmcPageHeading" />
                </uxap:heading>
                <uxap:expandedContent>
                    <Text id="integrationDetailSubtitle" text="{source} → {target}" />
                </uxap:expandedContent>
                <uxap:actions>
                    <Button
                        id="btnIntegrationApi"
                        text="{i18n>integrationApi}"
                        icon="sap-icon://chain-link"
                        type="Transparent"
                        press=".onShowApi"
                    />
                    <Button
                        id="btnEditIntegrationDetail"
                        text="{i18n>edit}"
                        icon="sap-icon://edit"
                        type="Emphasized"
                        press=".onEdit"
                    />
                </uxap:actions>
            </uxap:ObjectPageDynamicHeaderTitle>
        </uxap:headerTitle>
        <uxap:headerContent>
            <HBox id="integrationDetailAttributes" wrap="Wrap" class="lmcHeaderAttributes">
                <VBox id="attrSource">
                    <Label id="lblAttrSource" text="{i18n>source}" />
                    <Text id="txtAttrSource" text="{source}" class="lmcStrong" />
                </VBox>
                <VBox id="attrTarget">
                    <Label id="lblAttrTarget" text="{i18n>target}" />
                    <Text id="txtAttrTarget" text="{target}" class="lmcStrong" />
                </VBox>
                <VBox id="attrId">
                    <Label id="lblAttrId" text="{i18n>id}" />
                    <Text id="txtAttrId" text="{ID}" class="lmcMonospace" />
                </VBox>
                <VBox id="attrCreated">
                    <Label id="lblAttrCreated" text="{i18n>createdAt}" />
                    <Text
                        id="txtAttrCreated"
                        text="{
                            path: 'createdAt',
                            type: '.DateTimeType',
                            formatOptions: {
                                pattern: 'dd/MM/yyyy HH:mm',
                                source: { pattern: 'yyyy-MM-dd\'T\'HH:mm:ss.SSSX' }
                            }
                        }"
                    />
                </VBox>
                <VBox id="attrModified">
                    <Label id="lblAttrModified" text="{i18n>modifiedAt}" />
                    <Text
                        id="txtAttrModified"
                        text="{
                            path: 'modifiedAt',
                            type: '.DateTimeType',
                            formatOptions: {
                                pattern: 'dd/MM/yyyy HH:mm',
                                source: { pattern: 'yyyy-MM-dd\'T\'HH:mm:ss.SSSX' }
                            }
                        }"
                    />
                </VBox>
                <VBox id="attrFieldCount">
                    <Label id="lblAttrFieldCount" text="{i18n>fields}" />
                    <Text id="txtAttrFieldCount" text="{view>/counts/fieldsTable}" class="lmcHeaderCount" />
                </VBox>
                <VBox id="attrGroupCount">
                    <Label id="lblAttrGroupCount" text="{i18n>groups}" />
                    <Text id="txtAttrGroupCount" text="{view>/counts/accessGroupsTable}" class="lmcHeaderCount" />
                </VBox>
            </HBox>
        </uxap:headerContent>
        <uxap:sections>
            <uxap:ObjectPageSection id="sectionFields" title="{i18n>payloadFields}" titleUppercase="false">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection id="subSectionFields" showTitle="false">
                        <Table
                            id="fieldsTable"
                            class="lmcCard"
                            mode="MultiSelect"
                            growing="true"
                            growingThreshold="50"
                            selectionChange=".onTableSelectionChange"
                            updateFinished=".onTableUpdateFinished"
                            items="{
                                path: 'fields',
                                parameters: {
                                    $count: true,
                                    $$updateGroupId: 'dialog'
                                },
                                sorter: { path: 'fieldName' }
                            }"
                        >
                            <headerToolbar>
                                <OverflowToolbar id="fieldsToolbar">
                                    <Title
                                        id="fieldsTableTitle"
                                        text="{= ${i18n>payloadFields} + ' (' + (${view>/counts/fieldsTable} || 0) + ')' }"
                                        level="H2"
                                    />
                                    <ToolbarSpacer id="fieldsToolbarSpacer" />
                                    <SearchField
                                        id="fieldsSearch"
                                        width="20rem"
                                        placeholder="{i18n>searchFields}"
                                        liveChange=".onSearchFields"
                                    />
                                    <Button
                                        id="btnAddField"
                                        text="{i18n>add}"
                                        icon="sap-icon://add"
                                        type="Emphasized"
                                        press=".onAddField"
                                    />
                                    <Button
                                        id="btnDeleteFields"
                                        text="{i18n>delete}"
                                        icon="sap-icon://delete"
                                        type="Transparent"
                                        enabled="{= ${view>/selected/fieldsTable} > 0 }"
                                        press=".onDeleteFields"
                                    />
                                </OverflowToolbar>
                            </headerToolbar>
                            <noData>
                                <IllustratedMessage
                                    id="fieldsNoData"
                                    illustrationType="{= ${view>/search/fieldsTable} ? 'sapIllus-NoSearchResults' : 'sapIllus-NoEntries' }"
                                    illustrationSize="Dot"
                                    title="{i18n>noFields}"
                                    description="{= ${view>/search/fieldsTable} ? ${i18n>noResultsFor}.replace('{0}', ${view>/search/fieldsTable}) : ${i18n>noFieldsHint} }"
                                />
                            </noData>
                            <columns>
                                <Column id="colFieldName">
                                    <Text id="hdrFieldName" text="{i18n>fieldName}" />
                                </Column>
                                <Column id="colFieldLabel">
                                    <Text id="hdrFieldLabel" text="{i18n>fieldLabel}" />
                                </Column>
                                <Column id="colFieldDescription" minScreenWidth="Tablet" demandPopin="true">
                                    <Text id="hdrFieldDescription" text="{i18n>description}" />
                                </Column>
                                <Column id="colFieldFilterable" hAlign="Center" width="7rem">
                                    <Text id="hdrFieldFilterable" text="{i18n>filterable}" />
                                </Column>
                                <Column id="colFieldSortable" hAlign="Center" width="7rem">
                                    <Text id="hdrFieldSortable" text="{i18n>sortable}" />
                                </Column>
                                <Column id="colFieldEdit" hAlign="End" width="4rem" />
                            </columns>
                            <items>
                                <ColumnListItem id="fieldItem">
                                    <cells>
                                        <Text id="cellFieldName" text="{fieldName}" class="lmcMonospace" />
                                        <ObjectIdentifier id="cellFieldLabel" title="{label}" />
                                        <Text id="cellFieldDescription" text="{= ${description} || '—' }" />
                                        <core:Icon
                                            id="cellFieldFilterable"
                                            src="{= %{isFilterable} ? 'sap-icon://accept' : 'sap-icon://less' }"
                                            color="{= %{isFilterable} ? 'Positive' : 'Neutral' }"
                                            tooltip="{= %{isFilterable} ? ${i18n>yes} : ${i18n>no} }"
                                        />
                                        <core:Icon
                                            id="cellFieldSortable"
                                            src="{= %{isSortable} ? 'sap-icon://accept' : 'sap-icon://less' }"
                                            color="{= %{isSortable} ? 'Positive' : 'Neutral' }"
                                            tooltip="{= %{isSortable} ? ${i18n>yes} : ${i18n>no} }"
                                        />
                                        <Button
                                            id="btnEditField"
                                            icon="sap-icon://edit"
                                            type="Transparent"
                                            tooltip="{i18n>edit}"
                                            press=".onEditField"
                                        />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
            <uxap:ObjectPageSection id="sectionAccessGroups" title="{i18n>groupsWithAccess}" titleUppercase="false">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection id="subSectionAccessGroups" showTitle="false">
                        <Table
                            id="accessGroupsTable"
                            class="lmcCard"
                            growing="true"
                            updateFinished=".onTableUpdateFinished"
                            items="{
                                path: '/Groups',
                                parameters: {
                                    $count: true,
                                    $expand: 'userGroups($select=ID)'
                                },
                                sorter: { path: 'description' },
                                suspended: true
                            }"
                        >
                            <headerToolbar>
                                <OverflowToolbar id="accessGroupsToolbar">
                                    <Title
                                        id="accessGroupsTableTitle"
                                        text="{= ${i18n>groupsWithAccess} + ' (' + (${view>/counts/accessGroupsTable} || 0) + ')' }"
                                        level="H2"
                                    />
                                    <ToolbarSpacer id="accessGroupsToolbarSpacer" />
                                    <Text id="accessGroupsHint" text="{i18n>manageLinksHint}" class="lmcHint" />
                                </OverflowToolbar>
                            </headerToolbar>
                            <noData>
                                <IllustratedMessage
                                    id="accessGroupsNoData"
                                    illustrationType="sapIllus-NoEntries"
                                    illustrationSize="Dot"
                                    title="{i18n>noAccessGroups}"
                                    description="{i18n>noAccessGroupsHint}"
                                />
                            </noData>
                            <columns>
                                <Column id="colAccessGroupDescription">
                                    <Text id="hdrAccessGroupDescription" text="{i18n>description}" />
                                </Column>
                                <Column id="colAccessGroupIas">
                                    <Text id="hdrAccessGroupIas" text="{i18n>iasGroup}" />
                                </Column>
                                <Column id="colAccessGroupUsers" hAlign="End" width="7rem">
                                    <Text id="hdrAccessGroupUsers" text="{i18n>users}" />
                                </Column>
                            </columns>
                            <items>
                                <ColumnListItem id="accessGroupItem" type="Navigation" press=".onAccessGroupPress">
                                    <cells>
                                        <ObjectIdentifier id="cellAccessGroupDescription" title="{description}" />
                                        <Text id="cellAccessGroupIas" text="{= ${iasUserGroup} || '—' }" class="lmcMonospace" />
                                        <Text id="cellAccessGroupUsers" text="{userGroups/$count}" />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
            <uxap:ObjectPageSection id="sectionNotifications" title="{i18n>notifications}" titleUppercase="false">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection id="subSectionNotificationUsers" showTitle="false">
                        <Table
                            id="notificationUsersTable"
                            class="lmcCard"
                            mode="MultiSelect"
                            growing="true"
                            growingThreshold="50"
                            selectionChange=".onTableSelectionChange"
                            updateFinished=".onTableUpdateFinished"
                            items="{
                                path: 'notifications',
                                parameters: {
                                    $count: true,
                                    $$updateGroupId: '$auto',
                                    $expand: 'user($select=ID,name,email)'
                                },
                                sorter: { path: 'user/name' },
                                filters: { path: 'user_ID', operator: 'NE', value1: null }
                            }"
                        >
                            <headerToolbar>
                                <OverflowToolbar id="notificationUsersToolbar">
                                    <Title
                                        id="notificationUsersTableTitle"
                                        text="{= ${i18n>users} + ' (' + (${view>/counts/notificationUsersTable} || 0) + ')' }"
                                        level="H2"
                                    />
                                    <ToolbarSpacer id="notificationUsersToolbarSpacer" />
                                    <SearchField
                                        id="notificationUsersSearch"
                                        width="20rem"
                                        placeholder="{i18n>searchUsers}"
                                        liveChange=".onSearchNotificationUsers"
                                    />
                                    <Button
                                        id="btnLinkNotificationUsers"
                                        text="{i18n>link}"
                                        icon="sap-icon://chain-link"
                                        type="Emphasized"
                                        press=".onLinkNotificationUsers"
                                    />
                                    <Button
                                        id="btnUnlinkNotificationUsers"
                                        text="{i18n>unlink}"
                                        icon="sap-icon://broken-link"
                                        type="Transparent"
                                        enabled="{= ${view>/selected/notificationUsersTable} > 0 }"
                                        press=".onUnlinkNotificationUsers"
                                    />
                                </OverflowToolbar>
                            </headerToolbar>
                            <noData>
                                <IllustratedMessage
                                    id="notificationUsersNoData"
                                    illustrationType="{= ${view>/search/notificationUsersTable} ? 'sapIllus-NoSearchResults' : 'sapIllus-NoEntries' }"
                                    illustrationSize="Dot"
                                    title="{i18n>noNotifiedUsers}"
                                    description="{= ${view>/search/notificationUsersTable} ? ${i18n>noResultsFor}.replace('{0}', ${view>/search/notificationUsersTable}) : ${i18n>noNotifiedUsersHint} }"
                                />
                            </noData>
                            <columns>
                                <Column id="colNotificationUserName">
                                    <Text id="hdrNotificationUserName" text="{i18n>name}" />
                                </Column>
                                <Column id="colNotificationUserEmail">
                                    <Text id="hdrNotificationUserEmail" text="{i18n>email}" />
                                </Column>
                                <Column id="colNotificationUserSuccess" hAlign="Center" width="7rem">
                                    <HBox id="hdrNotificationUserSuccessBox" alignItems="Center" justifyContent="Center">
                                        <core:Icon
                                            id="hdrNotificationUserSuccessIcon"
                                            src="sap-icon://sys-enter-2"
                                            color="Positive"
                                            class="sapUiTinyMarginEnd"
                                        />
                                        <Text id="hdrNotificationUserSuccess" text="{i18n>status_SUCCESS}" />
                                    </HBox>
                                </Column>
                                <Column id="colNotificationUserWarning" hAlign="Center" width="7rem">
                                    <HBox id="hdrNotificationUserWarningBox" alignItems="Center" justifyContent="Center">
                                        <core:Icon
                                            id="hdrNotificationUserWarningIcon"
                                            src="sap-icon://alert"
                                            color="Critical"
                                            class="sapUiTinyMarginEnd"
                                        />
                                        <Text id="hdrNotificationUserWarning" text="{i18n>status_WARNING}" />
                                    </HBox>
                                </Column>
                                <Column id="colNotificationUserError" hAlign="Center" width="7rem">
                                    <HBox id="hdrNotificationUserErrorBox" alignItems="Center" justifyContent="Center">
                                        <core:Icon
                                            id="hdrNotificationUserErrorIcon"
                                            src="sap-icon://error"
                                            color="Negative"
                                            class="sapUiTinyMarginEnd"
                                        />
                                        <Text id="hdrNotificationUserError" text="{i18n>status_ERROR}" />
                                    </HBox>
                                </Column>
                            </columns>
                            <items>
                                <ColumnListItem id="notificationUserItem">
                                    <cells>
                                        <Text id="cellNotificationUserName" text="{user/name}" />
                                        <Link id="cellNotificationUserEmail" text="{user/email}" href="{= 'mailto:' + ${user/email} }" />
                                        <CheckBox
                                            id="cellNotificationUserSuccess"
                                            selected="{notifyOnSuccess}"
                                            tooltip="{i18n>status_SUCCESS}"
                                            class="lmcCenteredCheckBox"
                                        />
                                        <CheckBox
                                            id="cellNotificationUserWarning"
                                            selected="{notifyOnWarning}"
                                            tooltip="{i18n>status_WARNING}"
                                            class="lmcCenteredCheckBox"
                                        />
                                        <CheckBox
                                            id="cellNotificationUserError"
                                            selected="{notifyOnError}"
                                            tooltip="{i18n>status_ERROR}"
                                            class="lmcCenteredCheckBox"
                                        />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </uxap:ObjectPageSubSection>
                    <uxap:ObjectPageSubSection id="subSectionNotificationGroups" showTitle="false">
                        <Table
                            id="notificationGroupsTable"
                            class="lmcCard"
                            mode="MultiSelect"
                            growing="true"
                            growingThreshold="50"
                            selectionChange=".onTableSelectionChange"
                            updateFinished=".onNotificationGroupsUpdateFinished"
                            items="{
                                path: 'notifications',
                                parameters: {
                                    $count: true,
                                    $$updateGroupId: '$auto',
                                    $expand: 'integrationGroup($select=ID;$expand=group($select=ID,description,iasUserGroup;$expand=userGroups($select=ID)))'
                                },
                                sorter: { path: 'integrationGroup/group/description' },
                                filters: { path: 'integrationGroup_ID', operator: 'NE', value1: null }
                            }"
                        >
                            <headerToolbar>
                                <OverflowToolbar id="notificationGroupsToolbar">
                                    <Title
                                        id="notificationGroupsTableTitle"
                                        text="{= ${i18n>accessGroups} + ' (' + (${view>/counts/notificationGroupsTable} || 0) + ')' }"
                                        level="H2"
                                    />
                                    <ToolbarSpacer id="notificationGroupsToolbarSpacer" />
                                    <SearchField
                                        id="notificationGroupsSearch"
                                        width="20rem"
                                        placeholder="{i18n>searchGroups}"
                                        liveChange=".onSearchNotificationGroups"
                                    />
                                    <Button
                                        id="btnLinkNotificationGroups"
                                        text="{i18n>link}"
                                        icon="sap-icon://chain-link"
                                        type="Emphasized"
                                        press=".onLinkNotificationGroups"
                                    />
                                    <Button
                                        id="btnUnlinkNotificationGroups"
                                        text="{i18n>unlink}"
                                        icon="sap-icon://broken-link"
                                        type="Transparent"
                                        enabled="{= ${view>/selected/notificationGroupsTable} > 0 }"
                                        press=".onUnlinkNotificationGroups"
                                    />
                                </OverflowToolbar>
                            </headerToolbar>
                            <noData>
                                <IllustratedMessage
                                    id="notificationGroupsNoData"
                                    illustrationType="{= ${view>/search/notificationGroupsTable} ? 'sapIllus-NoSearchResults' : 'sapIllus-NoEntries' }"
                                    illustrationSize="Dot"
                                    title="{i18n>noNotifiedGroups}"
                                    description="{= ${view>/search/notificationGroupsTable} ? ${i18n>noResultsFor}.replace('{0}', ${view>/search/notificationGroupsTable}) : ${i18n>noNotifiedGroupsHint} }"
                                />
                            </noData>
                            <columns>
                                <Column id="colNotificationGroupDescription">
                                    <Text id="hdrNotificationGroupDescription" text="{i18n>description}" />
                                </Column>
                                <Column id="colNotificationGroupIas">
                                    <Text id="hdrNotificationGroupIas" text="{i18n>iasGroup}" />
                                </Column>
                                <Column id="colNotificationGroupUsers" hAlign="End" width="7rem">
                                    <Text id="hdrNotificationGroupUsers" text="{i18n>users}" />
                                </Column>
                                <Column id="colNotificationGroupSuccess" hAlign="Center" width="7rem">
                                    <HBox id="hdrNotificationGroupSuccessBox" alignItems="Center" justifyContent="Center">
                                        <core:Icon
                                            id="hdrNotificationGroupSuccessIcon"
                                            src="sap-icon://sys-enter-2"
                                            color="Positive"
                                            class="sapUiTinyMarginEnd"
                                        />
                                        <Text id="hdrNotificationGroupSuccess" text="{i18n>status_SUCCESS}" />
                                    </HBox>
                                </Column>
                                <Column id="colNotificationGroupWarning" hAlign="Center" width="7rem">
                                    <HBox id="hdrNotificationGroupWarningBox" alignItems="Center" justifyContent="Center">
                                        <core:Icon
                                            id="hdrNotificationGroupWarningIcon"
                                            src="sap-icon://alert"
                                            color="Critical"
                                            class="sapUiTinyMarginEnd"
                                        />
                                        <Text id="hdrNotificationGroupWarning" text="{i18n>status_WARNING}" />
                                    </HBox>
                                </Column>
                                <Column id="colNotificationGroupError" hAlign="Center" width="7rem">
                                    <HBox id="hdrNotificationGroupErrorBox" alignItems="Center" justifyContent="Center">
                                        <core:Icon
                                            id="hdrNotificationGroupErrorIcon"
                                            src="sap-icon://error"
                                            color="Negative"
                                            class="sapUiTinyMarginEnd"
                                        />
                                        <Text id="hdrNotificationGroupError" text="{i18n>status_ERROR}" />
                                    </HBox>
                                </Column>
                            </columns>
                            <items>
                                <ColumnListItem id="notificationGroupItem">
                                    <cells>
                                        <ObjectIdentifier id="cellNotificationGroupDescription" title="{integrationGroup/group/description}" />
                                        <Text id="cellNotificationGroupIas" text="{= ${integrationGroup/group/iasUserGroup} || '—' }" class="lmcMonospace" />
                                        <Text
                                            id="cellNotificationGroupUsers"
                                            text="{
                                                parts: ['ID', 'view>/userCounts'],
                                                formatter: '.formatter.notifiedGroupUserCount'
                                            }"
                                        />
                                        <CheckBox
                                            id="cellNotificationGroupSuccess"
                                            selected="{notifyOnSuccess}"
                                            tooltip="{i18n>status_SUCCESS}"
                                            class="lmcCenteredCheckBox"
                                        />
                                        <CheckBox
                                            id="cellNotificationGroupWarning"
                                            selected="{notifyOnWarning}"
                                            tooltip="{i18n>status_WARNING}"
                                            class="lmcCenteredCheckBox"
                                        />
                                        <CheckBox
                                            id="cellNotificationGroupError"
                                            selected="{notifyOnError}"
                                            tooltip="{i18n>status_ERROR}"
                                            class="lmcCenteredCheckBox"
                                        />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
        </uxap:sections>
    </uxap:ObjectPageLayout>
</mvc:View>
