<mvc:View
    controllerName="com.hrpath.log.monitor.report.controller.Detail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:uxap="sap.uxap"
>
    <uxap:ObjectPageLayout
        id="detailPage"
        showTitleInHeaderContent="true"
        alwaysShowContentHeader="false"
        upperCaseAnchorBar="false"
        class="lmcPage"
    >
        <uxap:headerTitle>
            <uxap:ObjectPageDynamicHeaderTitle id="detailHeaderTitle">
                <uxap:navigationActions>
                    <!-- <OverflowToolbarButton id="btnFullScreen"
                        type="Transparent"
                        icon="sap-icon://full-screen"
                        press=".onFullScreen"
                        tooltip="{i18n>fullScreen}"
                        visible="{= ${fcl>/actionButtonsInfo/midColumn/fullScreen} !== null}"/>
                    <OverflowToolbarButton id="btnExitFullScreen"
                        type="Transparent"
                        icon="sap-icon://exit-full-screen"
                        press=".onExitFullScreen"
                        tooltip="{i18n>exitFullScreen}"
                        visible="{= ${fcl>/actionButtonsInfo/midColumn/exitFullScreen} !== null}"/> -->
                    <OverflowToolbarButton
                        id="btnCloseColumn"
                        type="Transparent"
                        icon="sap-icon://decline"
                        press=".onCloseColumn"
                        tooltip="{i18n>close}"
                        visible="{= ${fcl>/actionButtonsInfo/midColumn/closeColumn} !== null}"
                    />
                </uxap:navigationActions>
                <uxap:heading>
                    <Title
                        id="detailTitle"
                        text="{integration/description}"
                        level="H1"
                        class="lmcPageHeading"
                    />
                </uxap:heading>
                <uxap:expandedContent>
                    <ObjectStatus
                        id="detailStatusExpanded"
                        text="{path: 'status', formatter: '.formatter.statusText'}"
                        state="{path: 'status', formatter: '.formatter.statusState'}"
                        icon="{path: 'status', formatter: '.formatter.statusIcon'}"
                    />
                </uxap:expandedContent>
                <uxap:snappedContent>
                    <ObjectStatus
                        id="detailStatusSnapped"
                        text="{path: 'status', formatter: '.formatter.statusText'}"
                        state="{path: 'status', formatter: '.formatter.statusState'}"
                        icon="{path: 'status', formatter: '.formatter.statusIcon'}"
                    />
                </uxap:snappedContent>
            </uxap:ObjectPageDynamicHeaderTitle>
        </uxap:headerTitle>

        <uxap:headerContent>
            <HBox
                id="headerContent"
                wrap="Wrap"
                class="lmcHeaderAttributes"
            >
                <VBox id="attrSource">
                    <Label
                        id="lblAttrSource"
                        text="{i18n>source}"
                    />
                    <Text
                        id="txtAttrSource"
                        text="{integration/source}"
                        class="lmcStrong"
                    />
                </VBox>
                <VBox id="attrTarget">
                    <Label
                        id="lblAttrTarget"
                        text="{i18n>target}"
                    />
                    <Text
                        id="txtAttrTarget"
                        text="{integration/target}"
                        class="lmcStrong"
                    />
                </VBox>
                <VBox id="attrExecutedAt">
                    <Label
                        id="lblAttrExecutedAt"
                        text="{i18n>executedAtShort}"
                    />
                    <Text
                        id="txtAttrExecutedAt"
                        text="{
                            path: 'executedAt',
                            type: '.DateTimeType',
                            formatOptions: {
                                pattern: 'dd/MM/yyyy HH:mm:ss',
                                source: { pattern: 'yyyy-MM-dd\'T\'HH:mm:ss.SSSX' }
                            }
                        }"
                    />
                </VBox>
                <VBox id="attrLogId">
                    <Label
                        id="lblAttrLogId"
                        text="{i18n>logId}"
                    />
                    <Text
                        id="txtAttrLogId"
                        text="{ID}"
                        class="lmcMonospace"
                    />
                </VBox>
            </HBox>
        </uxap:headerContent>

        <uxap:sections>
            <uxap:ObjectPageSection
                id="sectionFields"
                title="{i18n>customFields}"
                titleUppercase="false"
            >
                <uxap:subSections>
                    <uxap:ObjectPageSubSection
                        id="subSectionFields"
                        showTitle="false"
                    >
                        <uxap:blocks>
                            <Table
                                id="fieldsTable"
                                class="lmcCard"
                                width="100%"
                            >
                                <noData>
                                    <IllustratedMessage
                                        id="fieldsNoData"
                                        illustrationType="sapIllus-NoEntries"
                                        illustrationSize="Dot"
                                        title="{i18n>noFields}"
                                        description="{i18n>noFieldsForLogHint}"
                                    />
                                </noData>
                            </Table>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

            <uxap:ObjectPageSection
                id="sectionPayload"
                title="{i18n>payload}"
                titleUppercase="false"
            >
                <uxap:subSections>
                    <uxap:ObjectPageSubSection
                        id="subSectionPayload"
                        showTitle="false"
                    >
                        <uxap:blocks>
                            <VBox id="payloadBlock">
                                <OverflowToolbar
                                    id="payloadToolbar"
                                    style="Clear"
                                >
                                    <Title
                                        id="payloadTitle"
                                        text="{i18n>payload}"
                                        level="H3"
                                    />
                                    <Text
                                        id="payloadType"
                                        text="{detail>/type}"
                                        class="lmcHint"
                                    />
                                    <ToolbarSpacer id="payloadToolbarSpacer" />
                                    <Button
                                        id="btnCopyPayload"
                                        text="{i18n>copy}"
                                        icon="sap-icon://copy"
                                        type="Transparent"
                                        press=".onCopyPayload"
                                    />
                                </OverflowToolbar>
                                <TextArea
                                    id="payloadArea"
                                    value="{detail>/text}"
                                    editable="false"
                                    rows="20"
                                    width="100%"
                                    growing="true"
                                    class="lmcMonospace lmcPayload"
                                />
                            </VBox>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
        </uxap:sections>
    </uxap:ObjectPageLayout>
</mvc:View>
