<mvc:View
    controllerName="com.hrpath.log.monitor.report.controller.Report"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:core="sap.ui.core"
>
    <f:DynamicPage
        id="page"
        headerExpanded="true"
        toggleHeaderOnTitleClick="true"
    >
        <f:title>
            <f:DynamicPageTitle id="pageTitle">
                <f:heading>
                    <Title
                        id="titleLogs"
                        text="{i18n>logMasterTitle}"
                    />
                </f:heading>
                <f:expandedContent>
                    <Text
                        id="itemCountText"
                        text=""
                    />
                </f:expandedContent>
                <f:snappedContent>
                    <Text
                        id="itemCountTextSnapped"
                        text=""
                    />
                </f:snappedContent>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader
                id="pageHeader"
                pinnable="true"
            >
                <fb:FilterBar
                    id="filterBar"
                    search=".onSearch"
                    showGoOnFB="true"
                    showClearOnFB="true"
                    showFilterConfiguration="false"
                >
                    <fb:filterGroupItems>
                        <fb:FilterGroupItem
                            id="fgiIntegration"
                            name="integration"
                            groupName="filters"
                            label="{i18n>filterIntegration}"
                            visibleInFilterBar="true"
                        >
                            <fb:control>
                                <MultiComboBox
                                    id="filterIntegration"
                                    placeholder="{i18n>filterIntegration}"
                                    items="{path: '/Integrations', sorter: {path: 'description'}}"
                                >
                                    <core:Item
                                        id="integrationFilterItem"
                                        key="{ID}"
                                        text="{description}"
                                    />
                                </MultiComboBox>
                            </fb:control>
                        </fb:FilterGroupItem>
                        <fb:FilterGroupItem
                            id="fgiSource"
                            name="source"
                            groupName="filters"
                            label="{i18n>filterSource}"
                            visibleInFilterBar="true"
                        >
                            <fb:control>
                                <Input
                                    id="filterSource"
                                    placeholder="{i18n>filterSource}"
                                    submit=".onSearch"
                                />
                            </fb:control>
                        </fb:FilterGroupItem>
                        <fb:FilterGroupItem
                            id="fgiTarget"
                            name="target"
                            groupName="filters"
                            label="{i18n>filterTarget}"
                            visibleInFilterBar="true"
                        >
                            <fb:control>
                                <Input
                                    id="filterTarget"
                                    placeholder="{i18n>filterTarget}"
                                    submit=".onSearch"
                                />
                            </fb:control>
                        </fb:FilterGroupItem>
                        <fb:FilterGroupItem
                            id="fgiDateRange"
                            name="dateRange"
                            groupName="filters"
                            label="{i18n>filterDateRange}"
                            visibleInFilterBar="true"
                        >
                            <fb:control>
                                <DateRangeSelection id="filterDateRange" />
                            </fb:control>
                        </fb:FilterGroupItem>
                        <fb:FilterGroupItem
                            id="fgiStatus"
                            name="status"
                            groupName="filters"
                            label="{i18n>filterStatus}"
                            visibleInFilterBar="true"
                        >
                            <fb:control>
                                <MultiComboBox
                                    id="filterStatus"
                                    selectedKeys="ERROR"
                                >
                                    <items>
                                        <core:Item
                                            id="statusSuccess"
                                            key="SUCCESS"
                                            text="SUCCESS"
                                        />
                                        <core:Item
                                            id="statusError"
                                            key="ERROR"
                                            text="ERROR"
                                        />
                                        <core:Item
                                            id="statusWarning"
                                            key="WARNING"
                                            text="WARNING"
                                        />
                                        <core:Item
                                            id="statusRunning"
                                            key="RUNNING"
                                            text="RUNNING"
                                        />
                                    </items>
                                </MultiComboBox>
                            </fb:control>
                        </fb:FilterGroupItem>
                    </fb:filterGroupItems>
                </fb:FilterBar>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <List
                id="integrationsList"
                items="{path: '/IntegrationLogs', parameters: {$count: true}}"
                noDataText="{i18n>noIntegrations}"
                growing="true"
                growingThreshold="5"
                updateFinished=".onListUpdateFinished"
            >
                <ObjectListItem
                    id="integrationItem"
                    title="{integration/description}"
                    intro="ID: {ID}"
                    press=".onIntegrationPress"
                    type="Navigation"
                >
                    <firstStatus>
                        <ObjectStatus
                            id="statusItem"
                            text="{status}"
                            state="{path: 'status', formatter: '.formatter.statusState'}"
                        />
                    </firstStatus>
                    <attributes>
                        <ObjectAttribute
                            id="attrSource"
                            text="{i18n>source}: {integration/source}"
                        />
                        <ObjectAttribute
                            id="attrTarget"
                            text="{i18n>target}: {integration/target}"
                        />
                    </attributes>
                </ObjectListItem>
            </List>
        </f:content>
    </f:DynamicPage>
</mvc:View>
