<mvc:View
    controllerName="com.hrpath.log.monitor.report.controller.Report"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:core="sap.ui.core"
>
    <f:DynamicPage
        id="page"
        headerExpanded="true"
        toggleHeaderOnTitleClick="true"
        class="lmcPage"
    >
        <f:title>
            <f:DynamicPageTitle id="pageTitle">
                <f:heading>
                    <Title
                        id="titleLogs"
                        text="{i18n>logMasterTitle}"
                        level="H1"
                        class="lmcPageHeading"
                    />
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader
                id="pageHeader"
                pinnable="true"
            >
                <fb:FilterBar
                    id="filterBar"
                    search=".onSearch"
                    clear=".onClear"
                    showGoOnFB="true"
                    showClearOnFB="true"
                    showFilterConfiguration="false"
                >
                    <fb:filterGroupItems>
                        <fb:FilterGroupItem
                            id="fgiIntegration"
                            name="integration"
                            groupName="filters"
                            label="{i18n>filterIntegration}"
                            visibleInFilterBar="true"
                        >
                            <fb:control>
                                <ComboBox
                                    id="filterIntegration"
                                    placeholder="{i18n>filterIntegration}"
                                    items="{path: '/Integrations', sorter: {path: 'description'}}"
                                    selectionChange=".onIntegrationChange"
                                >
                                    <core:Item
                                        id="integrationFilterItem"
                                        key="{ID}"
                                        text="{description}"
                                    />
                                </ComboBox>
                            </fb:control>
                        </fb:FilterGroupItem>
                        <fb:FilterGroupItem
                            id="fgiSource"
                            name="source"
                            groupName="filters"
                            label="{i18n>filterSource}"
                            visibleInFilterBar="true"
                        >
                            <fb:control>
                                <Input
                                    id="filterSource"
                                    placeholder="{i18n>filterSource}"
                                    submit=".onSearch"
                                />
                            </fb:control>
                        </fb:FilterGroupItem>
                        <fb:FilterGroupItem
                            id="fgiTarget"
                            name="target"
                            groupName="filters"
                            label="{i18n>filterTarget}"
                            visibleInFilterBar="true"
                        >
                            <fb:control>
                                <Input
                                    id="filterTarget"
                                    placeholder="{i18n>filterTarget}"
                                    submit=".onSearch"
                                />
                            </fb:control>
                        </fb:FilterGroupItem>
                        <fb:FilterGroupItem
                            id="fgiDateRange"
                            name="dateRange"
                            groupName="filters"
                            label="{i18n>filterDateRange}"
                            visibleInFilterBar="true"
                        >
                            <fb:control>
                                <DateRangeSelection id="filterDateRange" />
                            </fb:control>
                        </fb:FilterGroupItem>
                        <fb:FilterGroupItem
                            id="fgiStatus"
                            name="status"
                            groupName="filters"
                            label="{i18n>filterStatus}"
                            visibleInFilterBar="true"
                        >
                            <fb:control>
                                <MultiComboBox
                                    id="filterStatus"
                                    selectedKeys="ERROR"
                                >
                                    <items>
                                        <core:Item
                                            id="statusSuccess"
                                            key="SUCCESS"
                                            text="SUCCESS"
                                        />
                                        <core:Item
                                            id="statusError"
                                            key="ERROR"
                                            text="ERROR"
                                        />
                                        <core:Item
                                            id="statusWarning"
                                            key="WARNING"
                                            text="WARNING"
                                        />
                                        <core:Item
                                            id="statusRunning"
                                            key="RUNNING"
                                            text="RUNNING"
                                        />
                                    </items>
                                </MultiComboBox>
                            </fb:control>
                        </fb:FilterGroupItem>
                    </fb:filterGroupItems>
                </fb:FilterBar>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <Table
                id="logsTable"
                class="lmcCard"
                growing="true"
                growingThreshold="20"
                growingTriggerText="{i18n>more}"
                sticky="ColumnHeaders,HeaderToolbar"
                updateFinished=".onTableUpdateFinished"
                items="{path: '/IntegrationLogs', parameters: {$count: true}}"
            >
                <headerToolbar>
                    <OverflowToolbar id="logsToolbar">
                        <Title
                            id="logsTableTitle"
                            text="{= ${i18n>logsTableTitle} + ' (' + (${view>/counts/logsTable} || 0) + ')' }"
                            level="H2"
                        />
                    </OverflowToolbar>
                </headerToolbar>
                <noData>
                    <IllustratedMessage
                        id="logsNoData"
                        illustrationType="{= ${view>/hasFilters} ? 'sapIllus-NoSearchResults' : 'sapIllus-NoEntries' }"
                        title="{= ${view>/hasFilters} ? ${i18n>noLogsFiltered} : ${i18n>noLogs} }"
                        description="{= ${view>/hasFilters} ? ${i18n>noLogsFilteredHint} : ${i18n>noLogsHint} }"
                        enableVerticalResponsiveness="true"
                    />
                </noData>
                <columns>
                    <Column id="colLogIntegration">
                        <Text id="hdrLogIntegration" text="{i18n>integration}" />
                    </Column>
                    <Column id="colLogExecutedAt" width="13rem" minScreenWidth="Tablet" demandPopin="true">
                        <Text id="hdrLogExecutedAt" text="{i18n>dateTime}" />
                    </Column>
                    <Column id="colLogStatus" width="10rem">
                        <Text id="hdrLogStatus" text="{i18n>status}" />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem
                        id="logItem"
                        type="Navigation"
                        press=".onIntegrationPress"
                    >
                        <cells>
                            <ObjectIdentifier
                                id="cellLogIntegration"
                                title="{integration/description}"
                                text="{integration/source} → {integration/target}"
                            />
                            <Text
                                id="cellLogExecutedAt"
                                text="{
                                    path: 'executedAt',
                                    type: '.DateTimeType',
                                    formatOptions: {
                                        pattern: 'dd/MM/yyyy HH:mm:ss',
                                        source: { pattern: 'yyyy-MM-dd\'T\'HH:mm:ss.SSSX' }
                                    }
                                }"
                            />
                            <ObjectStatus
                                id="cellLogStatus"
                                text="{path: 'status', formatter: '.formatter.statusText'}"
                                state="{path: 'status', formatter: '.formatter.statusState'}"
                                icon="{path: 'status', formatter: '.formatter.statusIcon'}"
                            />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </f:content>
    </f:DynamicPage>
</mvc:View>
