{
  "name": "hr-path-cap-log-monitor",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@cap-js/hana": "^3.1.1",
    "@sap/cds": "^10",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3.1.1",
    "@sap/cds-dk": "^9.9.6",
    "cds-plugin-ui5": "^0.17.0",
    "mbt": "^1.2.49",
    "rimraf": "^6.1.3"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-log.monitor.report": "cds watch --open com.hrpath.log.monitor.report/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy hr-path-cap-log-monitor --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "private": true,
  "cds": {
    "requires": {
      "auth": {
        "kind": "mocked",
        "users": {
          "alice@dummy.com": {
            "password": "1234",
            "roles": [
              "report-viewer"
            ]
          },
          "john.doe@dummy.com": {
            "password": "1234",
            "roles": [
              "report-viewer",
              "administrator"
            ]
          },
          "integration": {
            "password": "1234",
            "roles": [
              "system-user"
            ]
          }
        }
      },
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db.sqlite"
        }
      },
      "destinations": true,
      "html5-repo": true,
      "workzone": true,
      "[production]": {
        "auth": "xsuaa",
        "db": "hana"
      }
    }
  },
  "workspaces": [
    "app/*"
  ]
}